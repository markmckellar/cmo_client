# The pet door camera on the Pi (a system service, run as pi):
#   sudo cp systemd/cmo_watch_pet_door.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cmo_watch_pet_door
[Unit]
Description=CMO pet door camera (cmo_watch: saves people/animal movies, uploads them to cmo_server, alerts)
Documentation=file:///home/pi/dev/cmo_client/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dev/cmo_client
ExecStart=/usr/bin/python3 /home/pi/dev/cmo_client/cmo_watch.py /home/pi/dev/cmo_client/pet_door.properties
# cmo_watch logs to its log_file (~/logs/pet_watch.log); the journal only gets crashes
StandardOutput=null
StandardError=journal
# SIGTERM: finish the open segment, write and upload events already detected
TimeoutStopSec=240
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
