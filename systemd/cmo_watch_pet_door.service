# The pet door camera on the Pi (a system service, run as mm):
#   sudo cp systemd/cmo_watch_pet_door.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cmo_watch_pet_door
[Unit]
Description=CMO pet door camera (cmo_watch: saves people/animal movies, uploads them to cmo_server, alerts)
Documentation=file:///home/mm/dev/cmo_client/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mm
WorkingDirectory=/home/mm/dev/cmo_client
ExecStart=/usr/bin/python3 /home/mm/dev/cmo_client/cmo_watch.py /home/mm/dev/cmo_client/pet_door.properties
# cmo_watch logs to its log_file (~/logs/pet_watch.log); the journal only gets crashes
StandardOutput=null
StandardError=journal
# SIGTERM: finish the open segment, write and upload events already detected
TimeoutStopSec=240
# SIGTERM to cmo_watch only: it stops its own ffmpeg and rpicam-vid in order. With the default (every
# process at once) the open segment's MP4 is cut off before ffmpeg can finish it.
KillMode=mixed
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
